@page
@model LogoutModel
@{
    ViewData["Title"] = "До скоро!";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center animate__animated animate__fadeInDown">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);">
                <div class="card-body p-5">
                    <div class="display-1 mb-4">👋</div>
                    <h1 class="fw-bold text-dark mb-3">До скоро!</h1>
                    <p class="lead text-muted mb-5">
                        Успешно излязохте от профила си в <strong>PredictLeague</strong>. Очакваме ви отново за следващите дербита! ⚽🏆
                    </p>

                    <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
                        <a href="/" class="btn btn-primary btn-lg px-4 rounded-pill shadow-sm">
                            🏠 Начало
                        </a>
                        <a asp-page="./Login" class="btn btn-outline-dark btn-lg px-4 rounded-pill">
                            🔑 Влез отново
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
