@model IEnumerable<PredictLeague.Models.Prediction>

@{
    ViewData["Title"] = "My Predictions";
}

<div class="container mt-4">

    <h2 class="fw-bold text-primary mb-4">
        🎯 My Predictions
    </h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            You haven't made any predictions yet.
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="card-title text-muted">Total Predictions</h5>
                        <h2 class="fw-bold text-primary">@Model.Count()</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="card-title text-muted">Total Points</h5>
                        <h2 class="fw-bold text-success">@Model.Sum(p => p.Points) ⭐</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover text-center align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Match</th>
                        <th>Your Prediction</th>
                        <th>Result</th>
                        <th>Points</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var isNew = (DateTime.Now - p.CreatedAt).TotalMinutes < 5;
                        <tr class="@(isNew ? "table-success" : "")">
                            <td>
                                <b>@p.Match.HomeTeam</b> vs <b>@p.Match.AwayTeam</b>
                                @if (isNew)
                                {
                                    <span class="badge bg-success ms-2">NEW!</span>
                                }
                            </td>

                            <td>
                                @p.PredictedHomeScore : @p.PredictedAwayScore
                            </td>

                            <td>
                                @if (p.Match.IsFinished)
                                {
                                    <b>@p.Match.HomeScore - @p.Match.AwayScore</b>
                                }
                                else
                                {
                                    <span class="text-muted">Upcoming</span>
                                }
                            </td>

                            <td>
                                @if (p.Match.IsFinished)
                                {
                                    @if (p.Points == 10)
                                    {
                                        <span class="badge bg-warning text-dark">@p.Points ⭐ Exact!</span>
                                    }
                                    else if (p.Points == 3)
                                    {
                                        <span class="badge bg-info">@p.Points ⭐ Partial!</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@p.Points ⭐ Miss!</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark">Pending</span>
                                }
                            </td>

                            <td>@p.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
