@model IEnumerable<PredictLeague.Models.Prediction>

@{
    ViewData["Title"] = "Моите Прогнози";

    // Показваме само най-новата прогноза за всеки мач, ако има дубликати
    var uniquePredictions = Model
        .GroupBy(p => p.MatchId)
        .Select(g => g.OrderByDescending(x => x.CreatedAt).First())
        .OrderByDescending(x => x.CreatedAt)
        .ToList();
}

<style>
    .predictions-container {
        padding: 2rem 0;
        max-width: 1200px;
        margin: 0 auto;
    }
    
    .header-section {
        background: linear-gradient(135deg, #1e3a8a, #3b82f6, #60a5fa);
        border-radius: 24px;
        padding: 3.5rem 2rem;
        margin-bottom: 3rem;
        text-align: center;
        box-shadow: 0 20px 50px rgba(59, 130, 246, 0.2);
        border: 1px solid rgba(255,255,255,0.1);
        position: relative;
        overflow: hidden;
    }

    .header-section::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        animation: rotate 20s linear infinite;
        pointer-events: none;
    }

    @@keyframes rotate {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    .refresh-btn {
        background: #ffd700;
        color: #1e3a8a;
        border: none;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .refresh-btn:hover {
        transform: scale(1.05) translateY(-2px);
        background: #fff;
        box-shadow: 0 10px 20px rgba(255, 215, 0, 0.3);
    }

    .prediction-card {
        background: rgba(18, 18, 18, 0.7);
        backdrop-filter: blur(15px);
        border-radius: 24px;
        border: 1px solid rgba(255,255,255,0.08);
        padding: 2rem;
        margin-bottom: 2rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

    .prediction-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        border-color: rgba(255, 215, 0, 0.3);
    }

    .match-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .team-name {
        font-size: 1.4rem;
        font-weight: 800;
        color: #fff;
        width: 40%;
    }

    .score-display {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .score-badge {
        background: #000;
        padding: 10px 25px;
        border-radius: 14px;
        font-size: 2rem;
        font-weight: 900;
        color: #ffd700;
        border: 1px solid rgba(255, 215, 0, 0.2);
        box-shadow: inset 0 0 15px rgba(255, 215, 0, 0.1);
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 2rem;
        margin-top: 1.5rem;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .detail-label {
        font-size: 0.75rem;
        color: rgba(255,255,255,0.45);
        text-transform: uppercase;
        letter-spacing: 1.2px;
        font-weight: 700;
    }

    .detail-value {
        color: #fff;
        font-weight: 600;
        font-size: 1.05rem;
    }

    .points-section {
        background: linear-gradient(90deg, #ffd700, #ffa500);
        padding: 1rem 2rem;
        border-radius: 12px;
        color: #000;
        font-weight: 900;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .status-badge {
        padding: 6px 15px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 800;
    }

    .new-tag {
        position: absolute;
        top: 20px;
        right: -35px;
        background: #e91e63;
        color: #fff;
        padding: 5px 40px;
        transform: rotate(45deg);
        font-size: 0.7rem;
        font-weight: 900;
        box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    }
</style>

<div class="predictions-container">
    <div class="header-section animate__animated animate__fadeInDown">
        <h1 class="display-4 fw-bold text-white mb-2">🎯 Моите Прогнози</h1>
        <p class="lead text-white-50">Брой мачове: @uniquePredictions.Count | Общо точки: @uniquePredictions.Sum(p => p.Points) ⭐</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4 border-0 shadow-sm animate__animated animate__fadeIn" role="alert">
            <strong>✅ Успех!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show rounded-4 mb-4 border-0 shadow-sm animate__animated animate__fadeIn" role="alert">
            <strong>ℹ️ Инфо:</strong> @TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!uniquePredictions.Any())
    {
        <div class="text-center py-5">
            <h3 class="text-white-50">Все още нямате направени прогнози.</h3>
            <a href="/Matches" class="btn btn-warning mt-4 px-5 py-3 rounded-pill fw-bold">Започни сега!</a>
        </div>
    }
    else
    {
        @foreach (var p in uniquePredictions)
        {
            var isNew = (DateTime.Now - p.CreatedAt).TotalMinutes < 5;
            <div class="prediction-card animate__animated animate__fadeInUp">
                @if (isNew) { <div class="new-tag">NEW!</div> }
                
                <div class="match-header">
                    <div class="team-name">@p.Match.HomeTeam</div>
                    
                    <div class="score-display">
                        <div class="detail-label mb-2">Вашата Прогноза</div>
                        <div class="score-badge">@p.PredictedHomeScore : @p.PredictedAwayScore</div>
                    </div>

                    <div class="team-name text-end">@p.Match.AwayTeam</div>
                </div>

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-4">
                    <div class="details-grid flex-grow-1">
                        @if (!string.IsNullOrEmpty(p.AnytimeGoalscorer) && p.AnytimeGoalscorer != "Няма" && p.AnytimeGoalscorer != "None")
                        {
                            <div class="detail-item">
                                <span class="detail-label">⚽ Голмайстор</span>
                                <span class="detail-value">@p.AnytimeGoalscorer</span>
                            </div>
                        }
                        
                        @if (p.PredictedCorners > 0)
                        {
                            <div class="detail-item">
                                <span class="detail-label">⛳ Корнери</span>
                                <span class="detail-value">@p.PredictedCorners</span>
                            </div>
                        }

                        @if (p.PredictedYellowCards > 0 || p.PredictedRedCards > 0)
                        {
                            <div class="detail-item">
                                <span class="detail-label">🟨 Картони</span>
                                <span class="detail-value">@p.PredictedYellowCards ж. / @p.PredictedRedCards ч.</span>
                            </div>
                        }

                        @if (p.PredictedPenalty.HasValue)
                        {
                            <div class="detail-item">
                                <span class="detail-label">🎯 Дузпа</span>
                                <span class="detail-value">@(p.PredictedPenalty.Value ? "Да" : "Не")</span>
                            </div>
                        }

                        <div class="detail-item">
                            <span class="detail-label">📅 Дата</span>
                            <span class="detail-value">@p.CreatedAt.ToString("dd.MM HH:mm")</span>
                        </div>
                    </div>

                    <div class="d-flex flex-column align-items-end gap-2">
                        <div class="points-section">
                            @if (p.Match.IsFinished)
                            {
                                <span>@p.Points.ToString() PTS</span>
                                @if (p.Points == 10) { <span>⚡ ТОЧЕН!</span> }
                                else if (p.Points > 0) { <span>🧤 СПЕЧЕЛЕНИ</span> }
                                else { <span>❌ ПРОПУСК</span> }
                            }
                            else
                            {
                                <span>@p.Points.ToString() PTS</span>
                                <span style="font-size: 0.8rem; opacity: 0.7;">(Очаква се)</span>
                            }
                        </div>
                        
                        @if (!p.Match.IsFinished)
                        {
                            <a href="/Predictions/Create?matchId=@p.MatchId" class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-bold">
                                ✏️ Редактирай
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>
