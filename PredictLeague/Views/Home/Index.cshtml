@{
    ViewData["Title"] = "Home Page";
    var news = ViewBag.News;
}

<!-- HERO SECTION -->
<div class="text-center mt-5">
    <h1 class="display-4 fw-bold text-primary">Welcome to PredictLeague!</h1>
    <p class="lead text-secondary">Predict football matches and compete with friends.</p>

    <a href="/Matches" class="btn btn-lg btn-primary px-5 py-2 mt-3 shadow">
        ⚽ View Matches
    </a>
</div>

<hr class="mt-5 mb-4" />

<!-- NEWS SECTION -->
<div class="container mt-4">
    <h2 class="text-center fw-bold mb-4">📰 Latest Football News</h2>

    @if (news == null || news.articles == null)
    {
        <div class="alert alert-warning text-center">
            ⚠️ Unable to load football news at the moment.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var a in news.articles.Take(6))
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm border-0 rounded-3 h-100">

                        @if (!string.IsNullOrEmpty(a.urlToImage))
                        {
                            <img src="@a.urlToImage"
                                 class="card-img-top"
                                 style="height:200px; object-fit:cover; border-top-left-radius:10px; border-top-right-radius:10px;">
                        }

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@a.title</h5>

                            @if (!string.IsNullOrEmpty(a.description))
                            {
                                <p class="text-muted">@a.description</p>
                            }

                            <a href="@a.url"
                               class="btn btn-sm btn-success mt-auto"
                               target="_blank">
                                Read More →
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
