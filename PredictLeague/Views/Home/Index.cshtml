@using PredictLeague.Controllers
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@{
    ViewData["Title"] = "Home Page";
    var newsList = ViewData["NewsList"] as List<FootballNews> ?? new List<FootballNews>();
    var isLoggedIn = SignInManager.IsSignedIn(User);
}

<!-- HERO SECTION -->
<div class="hero-section position-relative text-white overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); min-height: 80vh; display: flex; align-items: center; border-bottom: 2px solid #ffd700;">
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background-image: url('https://images.unsplash.com/photo-1508098682722-e99c43a406b2?ixlib=rb-1.2.1&auto=format&fit=crop&w=1950&q=80'); background-size: cover; background-position: center; opacity: 0.15; mix-blend-mode: luminosity;"></div>
    
    <div class="container position-relative z-index-1 text-center">
        <div class="row justify-content-center">
            <div class="col-lg-8 fade-in-up">
                <span class="badge bg-warning text-dark mb-3 px-3 py-2 rounded-pill fw-bold">🏆 Игра №1 за футболни прогнози</span>
                <h1 class="display-2 fw-bold mb-4" style="text-shadow: 0 2px 10px rgba(0,0,0,0.3);">
                    Прогнозирай мача.<br>
                    <span class="text-warning">Покори класацията.</span>
                </h1>
                <p class="lead mb-5 opacity-75 fs-4">
                    Докажи футболните си знания, изкачи се до върха и спечели ежеседмични награди и признание.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="@(isLoggedIn ? "/Matches" : "/Identity/Account/Login")" 
                       class="btn btn-warning btn-lg px-5 py-3 rounded-pill shadow-lg fw-bold" 
                       style="background-color: #ffd700; color: #0f172a; border: none;">
                        Започни да прогнозираш ⚽
                    </a>
                    <a href="#how-it-works" class="btn btn-outline-light btn-lg px-5 py-3 rounded-pill fw-bold" style="border-width: 2px; color: #fff;">
                        Как работи
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Decorative Elements -->
    <div class="position-absolute bottom-0 start-0 w-100 overflow-hidden" style="line-height: 0;">
        <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none" style="width: 100%; height: 60px; fill: #f0f2f5; margin-bottom: -1px;">
            <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z"></path>
        </svg>
    </div>
</div>

<!-- FEATURES SECTION -->
<div id="how-it-works" class="py-5 my-5">
    <div class="container">
        <div class="text-center mb-5 fade-in-up delay-100">
            <h2 class="fw-bold display-6" style="color: #0f172a;">Как работи</h2>
            <p class="text-muted">Лесни стъпки да станеш шампион</p>
        </div>
        
        <div class="row g-4">
            <div class="col-md-4 fade-in-up delay-200">
                <div class="card h-100 border-0 shadow-sm text-center p-4 card-hover rounded-4">
                    <div class="mb-3 display-4">🔮</div>
                    <h3 class="h4 fw-bold mb-3">Прогнозирай мачове</h3>
                    <p class="text-muted">Разгледай предстоящите мачове от топ европейските лиги и изпрати своите прогнози за резултат преди началото на мача.</p>
                </div>
            </div>
            <div class="col-md-4 fade-in-up delay-200">
                <div class="card h-100 border-0 shadow-sm text-center p-4 card-hover rounded-4">
                    <div class="mb-3 display-4">🎯</div>
                    <h3 class="h4 fw-bold mb-3">Печели точки</h3>
                    <p class="text-muted">Вземи 10 точки за точен резултат или 3 точки, ако познаеш броя голове на единия отбор. Всеки гол е от значение!</p>
                </div>
            </div>
            <div class="col-md-4 fade-in-up delay-200">
                <div class="card h-100 border-0 shadow-sm text-center p-4 card-hover rounded-4">
                    <div class="mb-3 display-4">🥇</div>
                    <h3 class="h4 fw-bold mb-3">Изкачи се в класацията</h3>
                    <p class="text-muted">Състезавай се с твоите приятели и глобалната общност. Можеш ли да стигнеш до върха на класацията?</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ✅ WEEKLY REWARDS SECTION -->
<div class="py-5" style="background: white;">
    <div class="container">
        <div class="text-center mb-5 fade-in-up">
            <h2 class="display-6 fw-bold" style="color: #0f172a;">🎁 Спечели Награди на Седмицата</h2>
            <p class="text-muted">Бъди в Топ 3 на седмичната класация и вземи бонуси за своя Fantasy отбор!</p>
        </div>
        
        <div class="row g-4 justify-content-center">
            <!-- 🥇 1st Place -->
            <div class="col-md-4 fade-in-up delay-100">
                <div class="card h-100 border-0 shadow-lg text-center p-4 rounded-4 position-relative overflow-hidden" 
                     style="background: linear-gradient(135deg, #fff 0%, #fffbe6 100%); border: 1px solid #ffd700 !important;">
                    <div class="fs-1 mb-3">🥇</div>
                    <h3 class="h4 fw-bold mb-3">1-во Място</h3>
                    <ul class="list-unstyled text-muted mb-0 text-start ps-3">
                        <li class="mb-2">🏆 Статус "Шампион на седмицата"</li>
                        <li class="mb-2">💰 +200 Бонус точки</li>
                        <li>🌟 Златна значка до името</li>
                    </ul>
                </div>
            </div>
            
            <!-- 🥈 2nd Place -->
            <div class="col-md-4 fade-in-up delay-200">
                <div class="card h-100 border-0 shadow-sm text-center p-4 rounded-4" 
                     style="background: #f8fafc; border: 1px solid #e2e8f0 !important;">
                    <div class="fs-1 mb-3">🥈</div>
                    <h3 class="h4 fw-bold mb-3">2-ро Място</h3>
                    <ul class="list-unstyled text-muted mb-0 text-start ps-3">
                        <li class="mb-2">🥈 Статус "Вицешампион"</li>
                        <li class="mb-2">💰 +150 Бонус точки</li>
                        <li>🥈 Сребърна значка</li>
                    </ul>
                </div>
            </div>

            <!-- 🥉 3rd Place -->
            <div class="col-md-4 fade-in-up delay-300">
                <div class="card h-100 border-0 shadow-sm text-center p-4 rounded-4" 
                     style="background: #f8fafc; border: 1px solid #e2e8f0 !important;">
                    <div class="fs-1 mb-3">🥉</div>
                    <h3 class="h4 fw-bold mb-3">3-то Място</h3>
                    <ul class="list-unstyled text-muted mb-0 text-start ps-3">
                        <li class="mb-2">🥉 Статус "Бронзов медалист"</li>
                        <li class="mb-2">💰 +100 Бонус точки</li>
                        <li>🥉 Бронзова значка</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- BUILD DREAM TEAM SECTION -->
<div class="bg-light py-5 border-top border-bottom">
    <div class="container">
         <div class="row align-items-center">
             <div class="col-lg-6 mb-4 mb-lg-0 fade-in-up">
                 <img src="~/images/dream-team-exact.jpg" 
                      class="img-fluid rounded-4 shadow-lg" style="transform: rotate(-1deg); transition: transform 0.3s;" onmouseover="this.style.transform='rotate(0deg)'" onmouseout="this.style.transform='rotate(-1deg)'" alt="Dream Team">
             </div>
             <div class="col-lg-6 ps-lg-5 fade-in-up delay-100">
                 <h2 class="display-5 fw-bold mb-4 text-dark">Създай своя <span class="text-success">Dream Team</span></h2>
                 <p class="lead text-muted mb-4">
                     Избери своята формация, скаутирай играчи от топ 5 лигите и управлявай своите стартови 11. Състезавай се с други мениджъри, за да видиш кой има най-добрия отбор.
                 </p>
                 <div class="d-flex gap-3 flex-wrap">
                     <a href="/MyTeam" class="btn btn-success btn-lg rounded-pill px-4 shadow-sm fw-bold">
                         👕 Управлявай отбора си
                     </a>
                     <a href="/Leaderboard" class="btn btn-outline-dark btn-lg rounded-pill px-4 fw-bold">
                         🏆 Класация
                     </a>
                 </div>
             </div>
         </div>
    </div>
</div>

<!-- 🔄 TRANSFER HUB SECTION -->
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 fade-in-up">
        <div>
            <h2 class="fw-bold mb-0" style="color: #0f172a;">🌍 Европейски трансферен център</h2>
            <p class="text-muted mb-0">Последни големи трансфери от топ 5 европейските лиги</p>
        </div>
        <div class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold">ОБНОВЯВАНЕ В РЕАЛНО ВРЕМЕ</div>
    </div>

    @{
        var transfers = ViewData["Transfers"] as List<TransferEntry> ?? new List<TransferEntry>();
    }

    @if (transfers == null || !transfers.Any())
    {
        <div class="alert alert-light border shadow-sm text-center p-4 rounded-4">
            <p class="text-muted mb-0">Търсене на последните трансфери...</p>
        </div>
    }
    else
    {
        <div class="transfer-scroll-container pb-3" style="overflow-x: auto; white-space: nowrap; -webkit-overflow-scrolling: touch;">
            <div class="d-flex gap-4">
                @foreach (var t in transfers)
                {
                    var detail = t.Transfers.FirstOrDefault();
                    if (detail == null) continue;

                    <div class="transfer-card-premium" style="flex: 0 0 320px; display: inline-block; background: white; border-radius: 20px; padding: 25px; box-shadow: 0 10px 25px rgba(0,0,0,0.05); border: 1px solid rgba(0,0,0,0.03);">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-light text-primary shadow-sm px-3 py-2 rounded-pill">
                                @if (DateTime.TryParse(detail.Date, out DateTime dt)) {
                                    @dt.ToString("dd MMM yyyy")
                                } else {
                                    @detail.Date
                                }
                            </span>
                            <span class="text-success small fw-bold">@detail.Type</span>
                        </div>
                        
                        <div class="text-center mb-3">
                            <h5 class="fw-bold mb-1" style="color: #0f172a;">@t.Player.Name</h5>
                            <hr class="w-25 mx-auto my-2 opacity-10">
                        </div>

                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <div class="text-center" style="width: 45%;">
                                <img src="@(detail.Teams.Out?.Logo ?? "https://via.placeholder.com/40")" style="width: 45px; height: 45px; object-fit: contain;" class="mb-2">
                                <p class="small text-muted text-wrap mb-0" style="font-size: 0.7rem;">@detail.Teams.Out?.Name</p>
                            </div>
                            
                            <div class="text-primary fw-bold">➡️</div>

                            <div class="text-center" style="width: 45%;">
                                <img src="@(detail.Teams.In?.Logo ?? "https://via.placeholder.com/40")" style="width: 45px; height: 45px; object-fit: contain;" class="mb-2">
                                <p class="small fw-bold text-wrap mb-0" style="font-size: 0.7rem; color: #0f172a;">@detail.Teams.In?.Name</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- NEWS SECTION -->
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 fade-in-up delay-300">
        <div>
            <h2 class="fw-bold mb-0" style="color: #0f172a;">📰 Последни футболни новини</h2>
            <p class="text-muted mb-0">Бъди в крак с най-новите заглавия</p>
        </div>
        <button id="testNewsApiBtn" class="btn btn-outline-primary btn-sm rounded-pill">
            🔄 Обнови новините
        </button>
    </div>
    
    <div id="testResult" class="mb-3"></div>

    @if (newsList == null || !newsList.Any())
    {
        <div class="alert alert-light border shadow-sm text-center p-5 rounded-4 fade-in-up delay-300">
            <div class="display-1 mb-3">📭</div>
            <h4 class="fw-bold">Няма налични новини</h4>
            <p class="text-muted">Не успяхме да заредим новините в момента. Моля, опитайте по-късно.</p>
        </div>
    }
    else
    {
        <div id="newsContainer" class="fade-in-up delay-300">
            <div class="row g-4" id="newsRow">
                <!-- Новините ще бъдат заредени тук чрез JavaScript -->
            </div>
        </div>
        
        <!-- Pagination -->
        <nav aria-label="News pagination" class="mt-5 fade-in-up delay-300">
            <ul class="pagination justify-content-center" id="pagination">
                <!-- Бутоните за страници ще бъдат генерирани чрез JavaScript -->
            </ul>
        </nav>
        
        <!-- Store news data for JavaScript -->
        <script type="application/json" id="newsData">
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(newsList))
        </script>
    }
</div>

@if (!isLoggedIn)
{
    <!-- Call to Action Footer -->
    <div class="py-5 mt-5" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color: #fff;">
        <div class="container text-center py-4">
            <h2 class="fw-bold mb-3 text-warning">Готов ли си за игра?</h2>
            <p class="lead mb-5 opacity-75">Присъедини се към общността и покажи футболните си познания.</p>
            <a href="/Identity/Account/Register" class="btn btn-warning btn-lg px-5 py-3 rounded-pill fw-bold shadow-lg" style="background-color: #ffd700; color: #0f172a; border: none; font-size: 1.2rem;">
                Създай безплатен акаунт
            </a>
        </div>
    </div>
}

<script>
// Pagination settings
const ITEMS_PER_PAGE = 6;
let currentPage = 1;
let allNews = [];

document.addEventListener('DOMContentLoaded', function() {
    // Load news data
    const newsDataElement = document.getElementById('newsData');
    if (newsDataElement) {
        try {
            allNews = JSON.parse(newsDataElement.textContent);
            renderNews();
            renderPagination();
        } catch (e) {
            console.error("Error parsing news data", e);
        }
    }
    
    // Test button handler
    const testBtn = document.getElementById('testNewsApiBtn');
    const testResult = document.getElementById('testResult');
    
    if (testBtn) {
        testBtn.addEventListener('click', async function() {
            testBtn.disabled = true;
            testBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Loading...';
            testResult.innerHTML = '';
            
            try {
                const response = await fetch('/api/NewsApiTest/test');
                const data = await response.json();
                
                if (data.success) {
                    // Reload page to show new data if successful
                    location.reload();
                } else {
                    testResult.innerHTML = `
                        <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
                            <strong>Error:</strong> ${data.message || 'Could not fetch news'}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    `;
                }
            } catch (error) {
                testResult.innerHTML = `
                    <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
                        <strong>Error:</strong> ${error.message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                `;
            } finally {
                testBtn.disabled = false;
                testBtn.textContent = '🔄 Refresh News';
            }
        });
    }
});

function renderNews() {
    const newsRow = document.getElementById('newsRow');
    if (!newsRow) return;
    
    const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
    const endIndex = startIndex + ITEMS_PER_PAGE;
    const newsToShow = allNews.slice(startIndex, endIndex);
    
    newsRow.innerHTML = newsToShow.map(article => `
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden card-hover">
                <div class="position-relative">
                    <img src="${article.urlToImage || 'https://images.unsplash.com/photo-1574629810360-7efbbe195018?auto=format&fit=crop&w=400&h=200'}"
                         class="card-img-top"
                         style="height: 220px; object-fit: cover;"
                         onerror="this.src='https://images.unsplash.com/photo-1574629810360-7efbbe195018?auto=format&fit=crop&w=400&h=200'">
                    <div class="position-absolute bottom-0 start-0 w-100 p-3" style="background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);">
                        <small class="text-white fw-bold">${article.publishedAt ? new Date(article.publishedAt).toLocaleDateString('bg-BG') : 'Днес'}</small>
                    </div>
                </div>
                <div class="card-body d-flex flex-column p-4">
                    <h5 class="card-title fw-bold mb-3 line-clamp-2">${escapeHtml(article.title || 'Няма заглавие')}</h5>
                    <p class="card-text text-muted mb-4 line-clamp-3 small flex-grow-1">${escapeHtml(article.description || 'Няма налично описание.')}</p>
                    <a href="${escapeHtml(article.url)}"
                       class="btn btn-outline-primary rounded-pill w-100 mt-auto fw-bold"
                       target="_blank">
                        Прочети повече
                    </a>
                </div>
            </div>
        </div>
    `).join('');
    
    renderPagination();
}

function renderPagination() {
    const pagination = document.getElementById('pagination');
    if (!pagination) return;
    
    const totalPages = Math.ceil(allNews.length / ITEMS_PER_PAGE);
    
    if (totalPages <= 1) {
        pagination.innerHTML = '';
        return;
    }
    
    let paginationHTML = '';
    
    // Previous button
    paginationHTML += `
        <li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
            <a class="page-link border-0 rounded-circle mx-1" href="#" onclick="changePage(${currentPage - 1}); return false;" aria-label="Previous">
                <span aria-hidden="true">&laquo;</span>
            </a>
        </li>
    `;
    
    // Page numbers logic (simplified for better UI)
    const maxVisiblePages = 5;
    let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
    let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);
    
    if (endPage - startPage < maxVisiblePages - 1) {
        startPage = Math.max(1, endPage - maxVisiblePages + 1);
    }
    
    for (let i = startPage; i <= endPage; i++) {
        paginationHTML += `
            <li class="page-item ${i === currentPage ? 'active' : ''}">
                <a class="page-link border-0 rounded-circle mx-1 fw-bold" href="#" onclick="changePage(${i}); return false;">${i}</a>
            </li>
        `;
    }
    
    // Next button
    paginationHTML += `
        <li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
            <a class="page-link border-0 rounded-circle mx-1" href="#" onclick="changePage(${currentPage + 1}); return false;" aria-label="Next">
                <span aria-hidden="true">&raquo;</span>
            </a>
        </li>
    `;
    
    pagination.innerHTML = paginationHTML;
}

function changePage(page) {
    const totalPages = Math.ceil(allNews.length / ITEMS_PER_PAGE);
    if (page < 1 || page > totalPages) return;
    
    currentPage = page;
    renderNews();
    renderPagination();
    
    // Scroll to top of news section
    const newsContainer = document.getElementById('newsContainer');
    if (newsContainer) {
        newsContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
}

function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}
</script>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .page-link {
        color: var(--primary-color);
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .page-item.active .page-link {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
        color: white;
    }
    .page-link:hover {
        background-color: #e9ecef;
        color: var(--primary-dark);
    }
</style>
