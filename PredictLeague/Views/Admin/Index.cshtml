@model List<PredictLeague.Controllers.AdminUserViewModel>

@{
    ViewData["Title"] = "Админ Панел - Потребители";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2 class="fw-bold text-dark mb-0">🛠️ Администраторски Панел</h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3" role="alert">
            ✅ @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3" role="alert">
            ❌ @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show shadow-sm rounded-3" role="alert">
            ℹ️ @TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 🎁 СЕКЦИЯ: СЕДМИЧНИ НАГРАДИ -->
    <div class="card shadow-sm border-0 rounded-4 mb-5" style="background: linear-gradient(135deg, #fff 0%, #f0f9ff 100%);">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-7">
                    <h3 class="fw-bold text-primary mb-3">🎁 ТОП 3 ЗА СЕДМИЦАТА (Последни 7 дни)</h3>
                    <div class="list-group list-group-flush mb-0 bg-transparent">
                        @{
                            var weeklyWinners = ViewBag.WeeklyWinners as List<PredictLeague.Controllers.WeeklyWinnerViewModel>;
                            var ranks = new[] { "🥇", "🥈", "🥉" };
                            var prizes = new[] { "200 PTS", "150 PTS", "100 PTS" };
                        }

                        @if (weeklyWinners != null && weeklyWinners.Any())
                        {
                            for (int i = 0; i < weeklyWinners.Count; i++)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center bg-transparent border-0 px-0 py-2">
                                    <span class="fs-5">@ranks[i] @weeklyWinners[i].UserName</span>
                                    <span class="badge bg-white text-primary border border-primary rounded-pill px-3">
                                        @weeklyWinners[i].PointsThisWeek точки | 💰 @prizes[i]
                                    </span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted italic">Няма активни играчи за последната седмица.</div>
                        }
                    </div>
                </div>
                <div class="col-md-5 text-center mt-4 mt-md-0 border-start ps-4">
                    <form asp-controller="Admin" asp-action="DistributeWeeklyRewards" method="post" onsubmit="return confirm('Потвърждавате ли раздаването на награди за седмицата? ПРЕДУПРЕЖДЕНИЕ: Натискайте само веднъж на седмица.');">
                        <div class="mb-3 fs-1">📦</div>
                        <button type="submit" class="btn btn-warning btn-lg fw-bold rounded-pill px-5 shadow-sm" @(weeklyWinners?.Any() != true ? "disabled" : "")>
                            🎁 РАЗДАЙ НАГРАДИТЕ
                        </button>
                        <div class="mt-2 text-muted small">Внимавайте! Точките се добавят веднага.</div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <h3 class="fw-bold text-dark mb-4">👥 Управление на Потребители</h3>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Потребител</th>
                            <th>Имейл</th>
                            <th>Общо Прогнози</th>
                            <th>Общо Точки от Прогнози</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="fw-bold">@user.UserName</td>
                                <td class="text-muted">@user.Email</td>
                                <td>
                                    <span class="badge bg-secondary rounded-pill px-3 py-2">
                                        @user.TotalPredictions прогнози
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-success rounded-pill px-3 py-2 fs-6">
                                        @user.TotalPoints точки
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-controller="Admin" asp-action="UserPredictions" asp-route-id="@user.UserId" class="btn btn-sm btn-primary fw-bold rounded-pill px-3">
                                            Виж потребителя
                                        </a>
                                        
                                        @if (user.Email?.ToLower() != "admin@predictleague.com")
                                        {
                                            <form asp-controller="Admin" asp-action="DeleteUser" asp-route-id="@user.UserId" method="post" onsubmit="return confirm('Сигурни ли сте, че искате да изтриете този потребител напълно?');">
                                                <button type="submit" class="btn btn-sm btn-danger fw-bold rounded-pill px-3">
                                                    🗑️ Изтрий
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-secondary fw-bold rounded-pill px-3" disabled title="Главен администратор не може да бъде изтрит">
                                                👑 Админ
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
