@model List<PredictLeague.Models.Prediction>

@{
    ViewData["Title"] = "Прогнози на " + ViewBag.UserName;
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark mb-0">
            📋 Прогнози на <span class="text-primary">@ViewBag.UserName</span>
        </h2>
        
        <div class="d-flex align-items-center gap-3">
            <div class="badge bg-success py-2 px-4 shadow-sm" style="font-size: 1.1rem;">
                Общо Точки: @ViewBag.TotalPoints
            </div>
            
            <a asp-action="Index" class="btn btn-outline-secondary">
                ⬅️ Назад към потребителите
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center rounded-4 shadow-sm border-0 py-4">
            <h5 class="mb-0">Този потребител няма направени прогнози все още.</h5>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var prediction in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 rounded-4 border-top border-primary border-4">
                        <div class="card-body">
                            <h5 class="card-title text-center fw-bold mb-3 border-bottom pb-2">
                                @prediction.Match.HomeTeam 🆚 @prediction.Match.AwayTeam
                            </h5>
                            
                            <p class="mb-1 text-muted small text-center">
                                🕒 Направена на: @prediction.CreatedAt.ToString("dd MMM yyyy HH:mm")
                            </p>

                            <ul class="list-group list-group-flush mt-3 mb-3">
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <span>Прогноза на потребителя:</span>
                                    <strong class="text-primary fs-5">@prediction.PredictedHomeScore - @prediction.PredictedAwayScore</strong>
                                </li>
                                @if (prediction.Match.IsFinished)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span>Реален резултат:</span>
                                        <strong class="text-success fs-5">@prediction.Match.HomeScore - @prediction.Match.AwayScore</strong>
                                    </li>
                                }
                                @if (prediction.PredictedCorners > 0)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span>Прогнозирани Корнери:</span>
                                        <strong>@prediction.PredictedCorners</strong>
                                    </li>
                                }
                                @if (prediction.PredictedYellowCards > 0 || prediction.PredictedRedCards > 0)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span>Картони (Ж/Ч):</span>
                                        <strong>@(prediction.PredictedYellowCards ?? 0) / @(prediction.PredictedRedCards ?? 0)</strong>
                                    </li>
                                }
                                @if (!string.IsNullOrEmpty(prediction.AnytimeGoalscorer))
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span>Голмайстор:</span>
                                        <strong>@prediction.AnytimeGoalscorer</strong>
                                    </li>
                                }
                                @if (prediction.PredictedPenalty.HasValue)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span>Дузпа в мача:</span>
                                        <strong>@(prediction.PredictedPenalty.Value ? "ДА" : "НЕ")</strong>
                                    </li>
                                }
                            </ul>
                            
                        </div>
                        <div class="card-footer bg-light border-0 rounded-bottom-4 text-center">
                            <span class="badge @(prediction.Points > 0 ? "bg-success" : "bg-secondary") px-3 py-2 w-100 fs-6 shadow-sm">
                                Точки: @prediction.Points
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
