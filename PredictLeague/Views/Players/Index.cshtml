@model List<PredictLeague.Controllers.PlayerEntry>

@{
    ViewData["Title"] = "Футболен Пазар";
    var userPlayerIds = ViewBag.UserPlayerIds as HashSet<int> ?? new HashSet<int>();
}

<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=Outfit:wght@700;900&display=swap" rel="stylesheet">

<div class="elite-market-container">
    <div class="market-header animate__animated animate__fadeIn">
        <h1 class="market-title">⚽ ЕЛИТЕН СКAУТИНГ</h1>
        <p class="market-subtitle">Открий следващата си суперзвезда от @ViewBag.CurrentLeagueName</p>
    </div>

    <!-- 🌐 League Navigation -->
    <div class="league-pills-container animate__animated animate__fadeInUp">
        @if (ViewBag.Leagues != null)
        {
            foreach (var league in ViewBag.Leagues as Dictionary<int, string>)
            {
                var isActive = ViewBag.CurrentLeagueId == league.Key;
                <a href="@Url.Action("Index", new { leagueId = league.Key, page = 1 })" 
                   class="league-pill @(isActive ? "active" : "")">
                    <span class="flag-icon">
                        @if(league.Key == 39) { @("⚽") }
                        else if(league.Key == 2) { @("🏆") }
                        else { @("🔥") }
                    </span>
                    @league.Value
                </a>
            }
        }
    </div>

    <!-- 🔍 Smart Search -->
    <div class="search-wrapper row justify-content-center">
        <div class="col-md-7">
            <form method="get" asp-action="Index" class="search-form">
                <input type="hidden" name="leagueId" value="@ViewBag.CurrentLeagueId" />
                <div class="search-input-group">
                    <i class="search-icon">🔍</i>
                    <input type="text" name="search" class="search-field" 
                           placeholder="Потърси по име (напр. Haaland, Bellingham)..." 
                           value="@ViewBag.SearchTerm">
                    <button type="submit" class="search-btn">ТЪРСИ</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Pagination Stats -->
    <div class="pagination-overview d-flex justify-content-between align-items-center">
        @{
            var currentPage = (int)(ViewBag.CurrentPage ?? 1);
            var totalPages = (int)(ViewBag.TotalPages ?? 1);
            var prevPage = currentPage > 1 ? currentPage - 1 : 1;
            var nextPage = currentPage + 1;
            var isFirstPage = currentPage == 1;
            var isLastPage = currentPage >= totalPages;
            var shownPlayerIds = new HashSet<int>();
        }

        <a href="@Url.Action("Index", new { leagueId = ViewBag.CurrentLeagueId, page = prevPage, search = ViewBag.SearchTerm })" 
           class="nav-btn @(isFirstPage ? "disabled" : "")">⬅️ Предишна</a>

        <div class="page-indicator">Страница <span>@currentPage</span> от @totalPages</div>

        <a href="@Url.Action("Index", new { leagueId = ViewBag.CurrentLeagueId, page = nextPage, search = ViewBag.SearchTerm })" 
           class="nav-btn @(isLastPage ? "disabled" : "")">Следваща ➡️</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="market-alert success animate__animated animate__bounceIn">
            <span>🚀 @TempData["Success"]</span>
            <a asp-controller="MyTeam" asp-action="Index" class="alert-action">КЪМ МОЯ ОТБОР →</a>
        </div>
    }

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4 mt-2">
        
        @* 🏆 GOLD CARDS (Top Scorers) *@
        @if (ViewBag.TopScorers != null && string.IsNullOrEmpty(ViewBag.SearchTerm as string) && currentPage == 1)
        {
            var topScorers = ViewBag.TopScorers as List<PredictLeague.Controllers.PlayerEntry>;
            @foreach (var entry in topScorers)
            {
                 var player = entry.Player;
                 var stats = entry.Statistics.FirstOrDefault();
                 if (stats == null || shownPlayerIds.Contains(player.Id)) continue;
                 shownPlayerIds.Add(player.Id);

                 int playerCost = (int)Math.Max(10, Math.Round((double.TryParse(stats.Games.Rating, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double r) ? r : 0) * 5));

                 <div class="col">
                    <div class="player-card rare">
                        <div class="rare-ribbon">🏆 ТОП ГОЛМАЙСТОР</div>
                        <div class="card-header-visual">
                            <img src="@player.Photo" class="player-photo" alt="@player.Name">
                            <img src="@stats.Team.Logo" class="team-mini-logo" alt="team">
                        </div>
                        <div class="card-content">
                            <h3 class="player-name">@player.Name</h3>
                            <div class="player-meta">@stats.Team.Name • <span class="pos-badge">@stats.Games.Position</span></div>
                            
                            <div class="stats-row">
                                <div class="stat-box">
                                    <span class="stat-num">@(stats.Goals.Total ?? 0)</span>
                                    <span class="stat-label">ГОЛА</span>
                                </div>
                                <div class="stat-box">
                                    <span class="stat-num">@(stats.Goals.Assists ?? 0)</span>
                                    <span class="stat-label">АСИСТИ</span>
                                </div>
                                <div class="stat-box">
                                    <span class="stat-num highlight">@(stats.Games.Rating?.Substring(0, 3) ?? "-")</span>
                                    <span class="stat-label">РЕЙТИНГ</span>
                                </div>
                            </div>
                            
                            @if (userPlayerIds.Contains(player.Id)) {
                                <button class="action-btn owned" disabled>В ОТБОРА ТИ</button>
                            } else {
                                <form method="post" asp-action="AddToTeam" asp-controller="Players">
                                    <input type="hidden" name="playerId" value="@player.Id" />
                                    <input type="hidden" name="playerName" value="@player.Name" />
                                    <input type="hidden" name="position" value="@stats.Games.Position" />
                                    <input type="hidden" name="rating" value="@stats.Games.Rating" />
                                    <input type="hidden" name="teamName" value="@stats.Team.Name" />
                                    <button type="submit" class="action-btn gold">ВЗЕМИ ЗА @playerCost PTS</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        }

        @* 🥈 REGULAR CARDS *@
        @if (Model != null)
        {
            @foreach (var entry in Model)
            {
                var player = entry.Player;
                var stats = entry.Statistics.FirstOrDefault();
                if (stats == null || shownPlayerIds.Contains(player.Id)) continue;
                shownPlayerIds.Add(player.Id);

                int playerCost = (int)Math.Max(10, Math.Round((double.TryParse(stats.Games.Rating, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double rValue) ? rValue : 0) * 5));

                <div class="col">
                    <div class="player-card">
                        <div class="card-header-visual standard">
                            <img src="@player.Photo" class="player-photo" alt="@player.Name">
                            <div class="nationality-tag">🏳️ @player.Nationality</div>
                        </div>
                        <div class="card-content">
                            <h3 class="player-name">@player.Name</h3>
                            <div class="player-meta">@stats.Team.Name • <span class="pos-badge">@stats.Games.Position</span></div>
                            
                            <div class="stats-row">
                                <div class="stat-box">
                                    <span class="stat-num">@(stats.Goals.Total ?? 0)</span>
                                    <span class="stat-label">ГОЛА</span>
                                </div>
                                <div class="stat-box">
                                    <span class="stat-num">@(stats.Goals.Assists ?? 0)</span>
                                    <span class="stat-label">АСИСТИ</span>
                                </div>
                                <div class="stat-box">
                                    <span class="stat-num">@(stats.Games.Rating?.Substring(0, 3) ?? "-")</span>
                                    <span class="stat-label">РЕЙТИНГ</span>
                                </div>
                            </div>

                            @if (userPlayerIds.Contains(player.Id)) {
                                <button class="action-btn owned" disabled>В ОТБОРА ТИ</button>
                            } else {
                                <form method="post" asp-action="AddToTeam" asp-controller="Players">
                                    <input type="hidden" name="playerId" value="@player.Id" />
                                    <input type="hidden" name="playerName" value="@player.Name" />
                                    <input type="hidden" name="position" value="@stats.Games.Position" />
                                    <input type="hidden" name="rating" value="@stats.Games.Rating" />
                                    <input type="hidden" name="teamName" value="@stats.Team.Name" />
                                    <button type="submit" class="action-btn">ДОБАВИ (@playerCost PTS)</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    :root {
        --dark-bg: #0a0e17;
        --card-bg: rgba(255, 255, 255, 0.03);
        --accent-gold: #ffd700;
        --accent-blue: #007bff;
        --text-muted: rgba(255, 255, 255, 0.5);
    }

    body {
        background-color: var(--dark-bg);
        color: white;
        font-family: 'Inter', sans-serif;
    }

    .elite-market-container {
        padding: 40px 0;
    }

    .market-title {
        font-family: 'Outfit', sans-serif;
        font-weight: 900;
        font-size: 3.5rem;
        background: linear-gradient(to right, #fff, #666);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-align: center;
        letter-spacing: -1px;
    }

    .market-subtitle {
        text-align: center;
        color: var(--text-muted);
        font-size: 1.1rem;
        margin-top: -5px;
        margin-bottom: 40px;
    }

    /* 💊 League Pills */
    .league-pills-container {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-bottom: 50px;
        flex-wrap: wrap;
    }

    .league-pill {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 12px 25px;
        border-radius: 100px;
        color: white;
        text-decoration: none;
        font-weight: 700;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        align-items: center;
        backdrop-filter: blur(10px);
    }

    .league-pill:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-3px);
        color: white;
        border-color: var(--accent-blue);
    }

    .league-pill.active {
        background: var(--accent-blue);
        border-color: var(--accent-blue);
        box-shadow: 0 10px 20px rgba(0, 123, 255, 0.3);
    }

    /* 🔍 Search */
    .search-wrapper { margin-bottom: 60px; }
    .search-form { width: 100%; }
    .search-input-group {
        position: relative;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 20px;
        padding: 8px;
        display: flex;
        align-items: center;
    }
    .search-field {
        background: transparent;
        border: none;
        color: white;
        padding: 10px 15px;
        width: 100%;
        outline: none;
    }
    .search-btn {
        background: white;
        color: black;
        border: none;
        padding: 10px 30px;
        border-radius: 15px;
        font-weight: 900;
        cursor: pointer;
        transition: transform 0.2s;
    }
    .search-btn:hover { transform: scale(1.05); }

    /* 🃏 Player Cards */
    .player-card {
        background: var(--card-bg);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 28px;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        backdrop-filter: blur(20px);
        height: 100%;
        position: relative;
    }

    .player-card:hover {
        transform: translateY(-12px);
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(255, 255, 255, 0.2);
        box-shadow: 0 30px 60px rgba(0,0,0,0.4);
    }

    .rare-ribbon {
        position: absolute;
        top: 15px;
        left: 15px;
        background: var(--accent-gold);
        color: black;
        font-weight: 900;
        font-size: 0.7rem;
        padding: 4px 12px;
        border-radius: 50px;
        z-index: 10;
        box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3);
    }

    .card-header-visual {
        background: linear-gradient(to bottom, rgba(255,255,255,0.05), transparent);
        padding: 30px 20px 10px;
        text-align: center;
        position: relative;
    }

    .player-photo {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid rgba(255,255,255,0.1);
    }

    .team-mini-logo {
        position: absolute;
        bottom: 5px;
        right: 25%;
        width: 35px;
        height: 35px;
        background: white;
        border-radius: 50%;
        padding: 5px;
    }

    .card-content { padding: 20px; text-align: center; }
    .player-name { font-weight: 800; font-size: 1.3rem; margin-bottom: 5px; }
    .player-meta { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 20px; }
    .pos-badge { color: var(--accent-blue); font-weight: 700; }

    .stats-row {
        display: flex;
        justify-content: space-around;
        margin-bottom: 25px;
        background: rgba(255,255,255,0.02);
        padding: 15px 5px;
        border-radius: 20px;
    }
    .stat-box { display: flex; flex-direction: column; }
    .stat-num { font-weight: 900; font-size: 1.2rem; }
    .stat-num.highlight { color: var(--accent-gold); }
    .stat-label { font-size: 0.6rem; color: var(--text-muted); font-weight: 800; margin-top: 2px; }

    .action-btn {
        width: 100%;
        padding: 12px;
        border-radius: 18px;
        border: 1px solid rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.05);
        color: white;
        font-weight: 900;
        letter-spacing: 0.5px;
        transition: all 0.2s;
        cursor: pointer;
    }
    .action-btn:hover { background: white; color: black; }
    .action-btn.gold { background: var(--accent-gold); color: black; border: none; }
    .action-btn.gold:hover { transform: scale(1.02); box-shadow: 0 0 20px rgba(255, 215, 0, 0.2); }
    .action-btn.owned { background: rgba(255,255,255,0.1); color: var(--text-muted); cursor: default; }

    /* 📄 Pagination */
    .pagination-overview { margin-bottom: 30px; }
    .nav-btn {
        padding: 8px 20px;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.08);
        color: white;
        text-decoration: none;
        font-weight: 700;
        font-size: 0.9rem;
    }
    .nav-btn:hover { background: rgba(255,255,255,0.05); }
    .nav-btn.disabled { opacity: 0.3; cursor: default; pointer-events: none; }
    .page-indicator { color: var(--text-muted); font-weight: 700; }
    .page-indicator span { color: white; }

    .market-alert {
        padding: 15px 25px;
        border-radius: 18px;
        margin-bottom: 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 700;
    }
    .market-alert.success { background: rgba(40, 167, 69, 0.1); border: 1px solid rgba(40, 167, 69, 0.2); color: #4ade80; }
    .alert-action { color: white; text-decoration: none; background: #22c55e; padding: 5px 15px; border-radius: 10px; font-size: 0.8rem; }
    
    .nationality-tag { position: absolute; top: 15px; right: 15px; font-size: 0.75rem; color: var(--text-muted); background: rgba(0,0,0,0.4); padding: 4px 10px; border-radius: 50px; }
</style>
