@{
    ViewData["Title"] = "Избери Лига за Прогнози";
}

<div class="container py-5">
    <div class="text-center mb-5 fade-in-up">
        <h1 class="display-4 fw-bold text-primary mb-3">🌍 Избери Първенство</h1>
        <p class="lead text-muted">Избери любимата си лига, виж предстоящите мачове и направи своите прогнози!</p>
    </div>

    <div class="row g-4 justify-content-center">
        <!-- Premier League -->
        <div class="col-md-6 col-lg-4 fade-in-up delay-100">
            <a href="/Matches/PremierLeague" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm rounded-4 card-hover overflow-hidden position-relative">
                    <div class="bg-primary bg-gradient p-4 text-center">
                        <img src="https://media.api-sports.io/football/leagues/39.png" alt="Premier League" class="img-fluid" style="height: 100px; filter: drop-shadow(0px 4px 6px rgba(0,0,0,0.3));" />
                    </div>
                    <div class="card-body text-center p-4">
                        <h4 class="fw-bold text-dark mb-1">Premier League</h4>
                        <span class="badge bg-light text-dark border rounded-pill px-3 py-2 mt-2 shadow-sm">🏴󠁧󠁢󠁥󠁮󠁧󠁿 Англия</span>
                    </div>
                </div>
            </a>
        </div>

        <!-- La Liga -->
        <div class="col-md-6 col-lg-4 fade-in-up delay-200">
            <a href="/Matches/LaLiga" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm rounded-4 card-hover overflow-hidden position-relative">
                    <div class="bg-danger bg-gradient p-4 text-center">
                        <img src="https://media.api-sports.io/football/leagues/140.png" alt="La Liga" class="img-fluid" style="height: 100px; filter: drop-shadow(0px 4px 6px rgba(0,0,0,0.3));" />
                    </div>
                    <div class="card-body text-center p-4">
                        <h4 class="fw-bold text-dark mb-1">La Liga</h4>
                        <span class="badge bg-light text-dark border rounded-pill px-3 py-2 mt-2 shadow-sm">🇪🇸 Испания</span>
                    </div>
                </div>
            </a>
        </div>

        <!-- Serie A -->
        <div class="col-md-6 col-lg-4 fade-in-up delay-300">
            <a href="/Matches/SerieA" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm rounded-4 card-hover overflow-hidden position-relative">
                    <div class="bg-info bg-gradient p-4 text-center">
                        <img src="https://media.api-sports.io/football/leagues/135.png" alt="Serie A" class="img-fluid" style="height: 100px; filter: drop-shadow(0px 4px 6px rgba(0,0,0,0.3));" />
                    </div>
                    <div class="card-body text-center p-4">
                        <h4 class="fw-bold text-dark mb-1">Serie A</h4>
                        <span class="badge bg-light text-dark border rounded-pill px-3 py-2 mt-2 shadow-sm">🇮🇹 Италия</span>
                    </div>
                </div>
            </a>
        </div>

        <!-- Bundesliga -->
        <div class="col-md-6 col-lg-4 fade-in-up delay-400">
            <a href="/Matches/Bundesliga" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm rounded-4 card-hover overflow-hidden position-relative">
                    <div class="bg-dark bg-gradient p-4 text-center">
                        <img src="https://media.api-sports.io/football/leagues/78.png" alt="Bundesliga" class="img-fluid" style="height: 100px; filter: drop-shadow(0px 4px 6px rgba(0,0,0,0.3));" />
                    </div>
                    <div class="card-body text-center p-4">
                        <h4 class="fw-bold text-dark mb-1">Bundesliga</h4>
                        <span class="badge bg-light text-dark border rounded-pill px-3 py-2 mt-2 shadow-sm">🇩🇪 Германия</span>
                    </div>
                </div>
            </a>
        </div>

        <!-- Champions League -->
        <div class="col-md-6 col-lg-4 fade-in-up delay-500">
            <a href="/Matches/ChampionsLeague" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm rounded-4 card-hover overflow-hidden position-relative">
                    <div class="p-4 text-center" style="background: linear-gradient(135deg, #0b3d91 0%, #1e90ff 100%);">
                        <img src="https://media.api-sports.io/football/leagues/2.png" alt="Champions League" class="img-fluid" style="height: 100px; filter: drop-shadow(0px 4px 6px rgba(0,0,0,0.3));" />
                    </div>
                    <div class="card-body text-center p-4">
