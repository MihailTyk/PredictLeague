                    </div>
                </div>
            </a>
        </div>

        <!-- Ligue 1 -->
        <div class="col-md-6 col-lg-4 fade-in-up delay-100">
            <a href="/Matches/Ligue1" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm rounded-4 card-hover overflow-hidden position-relative">
                    <div class="p-4 text-center" style="background: linear-gradient(135deg, #dae1e7 0%, #001e50 100%);">
                        <img src="https://media.api-sports.io/football/leagues/61.png" alt="Ligue 1" class="img-fluid" style="height: 100px; filter: drop-shadow(0px 4px 6px rgba(0,0,0,0.3));" />
                    </div>
                    <div class="card-body text-center p-4">
                        <h4 class="fw-bold text-dark mb-1">Ligue 1</h4>
                        <span class="badge bg-light text-dark border rounded-pill px-3 py-2 mt-2 shadow-sm">🇫🇷 Франция</span>
                    </div>
                </div>
            </a>
        </div>

        <!-- Primeira Liga -->
        <div class="col-md-6 col-lg-4 fade-in-up delay-200">
            <a href="/Matches/PrimeiraLiga" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm rounded-4 card-hover overflow-hidden position-relative">
                    <div class="p-4 text-center" style="background: linear-gradient(135deg, #ef3123 0%, #c1272d 100%);">
                        <img src="https://media.api-sports.io/football/leagues/94.png" alt="Primeira Liga" class="img-fluid" style="height: 100px; filter: drop-shadow(0px 4px 6px rgba(0,0,0,0.3));" />
                    </div>
                    <div class="card-body text-center p-4">
                        <h4 class="fw-bold text-dark mb-1">Primeira Liga</h4>
                        <span class="badge bg-light text-dark border rounded-pill px-3 py-2 mt-2 shadow-sm">🇵🇹 Португалия</span>
                    </div>
                </div>
            </a>
        </div>

        <!-- Eredivisie -->
        <div class="col-md-6 col-lg-4 fade-in-up delay-300">
            <a href="/Matches/Eredivisie" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm rounded-4 card-hover overflow-hidden position-relative">
                    <div class="p-4 text-center" style="background: linear-gradient(135deg, #f39200 0%, #e65c00 100%);">
                        <img src="https://media.api-sports.io/football/leagues/88.png" alt="Eredivisie" class="img-fluid" style="height: 100px; filter: drop-shadow(0px 4px 6px rgba(0,0,0,0.3));" />
                    </div>
                    <div class="card-body text-center p-4">
                        <h4 class="fw-bold text-dark mb-1">Eredivisie</h4>
                        <span class="badge bg-light text-dark border rounded-pill px-3 py-2 mt-2 shadow-sm">🇳🇱 Нидерландия</span>
                    </div>
                </div>
            </a>
        </div>

        <!-- Parva Liga -->
        <div class="col-md-6 col-lg-4 fade-in-up delay-400">
            <a href="/Matches/ParvaLiga" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm rounded-4 card-hover overflow-hidden position-relative">
                    <div class="p-4 text-center" style="background: linear-gradient(135deg, #00966e 0%, #005a3c 100%);">
                        <img src="https://media.api-sports.io/football/leagues/172.png" alt="Parva Liga" class="img-fluid" style="height: 100px; filter: drop-shadow(0px 4px 6px rgba(0,0,0,0.3));" />
                    </div>
                    <div class="card-body text-center p-4">
                        <h4 class="fw-bold text-dark mb-1">Parva Liga</h4>
                        <span class="badge bg-light text-dark border rounded-pill px-3 py-2 mt-2 shadow-sm">🇧🇬 България</span>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

<style>
    .card-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .card-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,.15)!important;
    }
    .fade-in-up {
        animation: fadeInUp 0.6s ease-out forwards;
        opacity: 0;
    }
    .delay-100 { animation-delay: 100ms; }
    .delay-200 { animation-delay: 200ms; }
    .delay-300 { animation-delay: 300ms; }
    .delay-400 { animation-delay: 400ms; }
    .delay-500 { animation-delay: 500ms; }
    
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
