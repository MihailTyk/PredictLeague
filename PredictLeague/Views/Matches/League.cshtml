@model List<PredictLeague.Controllers.FootballMatch>

@{
    ViewData["Title"] = ViewBag.LeagueName;
}

<style>
    .league-banner {
        background: linear-gradient(135deg, #0b1a2e 0%, #1e3c72 100%);
        border-radius: 20px;
        color: white;
        padding: 3rem 2rem;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        margin-bottom: 3rem;
        position: relative;
        overflow: hidden;
    }
    .league-banner::after {
        content: '⚽';
        position: absolute;
        right: -20px;
        bottom: -40px;
        font-size: 15rem;
        opacity: 0.05;
    }
    .match-card {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        box-shadow: 0 6px 15px rgba(0,0,0,0.06);
        transition: transform 0.3s ease, box-shadow 0.3s;
        border-top: 5px solid #1e3c72;
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    .match-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 25px rgba(0,0,0,0.1);
    }
    .team-logo {
        width: 48px;
        height: 48px;
        object-fit: contain;
    }
    .match-time {
        font-size: 0.85rem;
        color: #6c757d;
        background: #f8f9fa;
        padding: 6px 15px;
        border-radius: 20px;
        display: inline-block;
        font-weight: 500;
    }
    .score-badge {
        font-size: 1.2rem;
        font-weight: bold;
        background: #1e3c72;
        color: white;
        padding: 0.4rem 1rem;
        border-radius: 8px;
    }
    .vs-badge {
        font-weight: bold;
        color: #adb5bd;
        font-size: 1rem;
    }
    .btn-predict {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        padding: 0.6rem 1.5rem;
        transition: all 0.2s;
        width: 100%;
    }
    .btn-predict:hover {
        background: linear-gradient(135deg, #2a5298 0%, #1e3c72 100%);
        box-shadow: 0 5px 15px rgba(30,60,114,0.3);
        color: white;
    }
    .fast-blink {
        animation: blink 1.5s infinite;
    }
    @@keyframes blink {
        0% { opacity: 1; }
        50% { opacity: 0.5; }
        100% { opacity: 1; }
    }
</style>

<div class="container py-4">
    <div class="league-banner">
        <h1 class="display-5 fw-bold mb-2">@ViewBag.LeagueName</h1>
        <p class="lead mb-1 opacity-75">Сезон @ViewBag.Season</p>
        <a href="@Url.Action("Standings", "Matches", new { leagueId = ViewBag.LeagueId, season = ViewBag.Season, leagueName = ViewBag.LeagueName })"
           class="btn mt-2 px-4 py-2 fw-bold"
           style="background: rgba(255,255,255,0.15); color: #fff; border: 1px solid rgba(255,255,255,0.25); border-radius: 30px; backdrop-filter: blur(10px); font-size: 0.9rem;">
            🏆 Виж Класацията
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger text-center rounded-4 shadow-sm border-0">
            @ViewBag.Error
        </div>
    }
    else if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning text-center rounded-4 shadow-sm border-0">
            <h4 class="mb-0">⚠️ Няма налични мачове в момента.</h4>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var match in Model)
            {
                var status = match.fixture.status.short_;
                string statusColor = status switch
                {
                    "FT" => "text-success",
                    "NS" => "text-primary",
                    "1H" or "2H" => "text-danger fast-blink",
                    _ => "text-secondary"
                };

                <div class="col-md-6 col-lg-4">
                    <div class="match-card">
                        <div class="text-center mb-3">
                            <div class="match-time mb-2">
                                🕒 @match.fixture.date.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                            </div>
                            <div class="fw-bold @statusColor" style="font-size: 0.9rem;">
                                @(status == "NS" ? "Предстоящ" : status == "FT" ? "Завършил" : "На живо")
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4 px-2">
                            <div class="text-center" style="width: 40%;">
                                <img src="@match.teams.home.logo" alt="@match.teams.home.name" class="team-logo mb-2" />
                                <h6 class="mb-0 fw-bold text-truncate" title="@match.teams.home.name">@match.teams.home.name</h6>
                            </div>

                            <div class="text-center" style="width: 20%;">
                                @if (match.goals.home.HasValue && match.goals.away.HasValue)
                                {
                                    <div class="score-badge">@match.goals.home - @match.goals.away</div>
                                }
                                else
                                {
                                    <div class="vs-badge">VS</div>
                                }
                            </div>

                            <div class="text-center" style="width: 40%;">
                                <img src="@match.teams.away.logo" alt="@match.teams.away.name" class="team-logo mb-2" />
                                <h6 class="mb-0 fw-bold text-truncate" title="@match.teams.away.name">@match.teams.away.name</h6>
                            </div>
                        </div>

                        <div class="mt-auto">
                            <a href="@Url.Action("MatchDetail", "Matches", new {
                                fixtureId = match.fixture.id,
                                homeTeamId = match.teams.home.id,
                                awayTeamId = match.teams.away.id,
                                homeTeam = match.teams.home.name,
                                awayTeam = match.teams.away.name,
                                homeLogo = match.teams.home.logo,
                                awayLogo = match.teams.away.logo,
                                matchDate = match.fixture.date.ToString("o"),
                                status = match.fixture.status.short_,
                                leagueId = ViewBag.LeagueId,
                                season = ViewBag.Season
                            })" class="btn btn-predict d-block text-center text-decoration-none">
                                @if (status == "NS")
                                {
                                    <span>🎯 Виж Мача</span>
                                }
                                else if (status == "FT")
                                {
                                    <span>📊 Статистика</span>
                                }
                                else
                                {
                                    <span>🔴 На живо — Детайли</span>
                                }
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
