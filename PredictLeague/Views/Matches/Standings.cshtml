@model PredictLeague.Controllers.FullStandingsViewModel

@{
    ViewData["Title"] = $"Класация - {Model.LeagueName}";
}

<style>
    :root {
        --primary: #1e3c72;
        --primary-light: #2a5298;
        --card-bg: #111827;
        --card-border: rgba(255,255,255,0.07);
        --text-muted: rgba(255,255,255,0.5);
    }

    .standings-container {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 20px;
        padding: 2rem;
        margin-top: 2rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    .league-header {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--card-border);
    }

    .league-logo {
        width: 80px;
        height: 80px;
        object-fit: contain;
    }

    .table-standings {
        width: 100%;
        color: #fff;
        border-collapse: separate;
        border-spacing: 0 8px;
    }

    .table-standings th {
        color: var(--text-muted);
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        padding: 0.75rem 1rem;
        border: none;
    }

    .table-standings tr {
        background: rgba(255, 255, 255, 0.03);
        transition: transform 0.2s, background 0.2s;
    }

    .table-standings tr:hover {
        background: rgba(255, 255, 255, 0.06);
        transform: scale(1.005);
    }

    .table-standings td {
        padding: 1rem;
        vertical-align: middle;
        border: none;
    }

    .table-standings tr td:first-child { border-radius: 12px 0 0 12px; }
    .table-standings tr td:last-child { border-radius: 0 12px 12px 0; }

    .rank-cell {
        font-weight: 800;
        font-size: 1.1rem;
        width: 50px;
        text-align: center;
    }

    .team-cell {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .team-logo-small {
        width: 32px;
        height: 32px;
        object-fit: contain;
    }

    .team-name {
        font-weight: 600;
    }

    .pts-cell {
        font-weight: 900;
        color: #fde047;
    }

    .form-indicator {
        display: inline-block;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        text-align: center;
        line-height: 24px;
        font-size: 0.7rem;
        font-weight: 700;
        margin-right: 4px;
    }

    .form-w { background: #22c55e; color: #fff; }
    .form-d { background: #eab308; color: #fff; }
    .form-l { background: #ef4444; color: #fff; }

    .stats-cell {
        color: rgba(255,255,255,0.7);
        font-size: 0.9rem;
    }

    .badge-description {
        font-size: 0.7rem;
        padding: 4px 8px;
        border-radius: 6px;
        background: rgba(255,255,255,0.05);
        color: var(--text-muted);
    }

    @@media (max-width: 768px) {
        .hide-mobile { display: none; }
        .standings-container { padding: 1rem; }
    }
</style>

<div class="container py-4">
    <a href="javascript:history.back()" class="text-white opacity-50 text-decoration-none mb-3 d-inline-block">
        ← Назад към лигите
    </a>

    <div class="standings-container">
        <div class="league-header">
            <img src="@Model.LeagueLogo" alt="@Model.LeagueName" class="league-logo" onerror="this.src='/img/default-league.png'" />
            <div>
                <h1 class="h2 fw-bold text-white mb-1">@Model.LeagueName</h1>
                <p class="mb-0 text-muted">
                    Сезон @Model.Season 
                    @if (!string.IsNullOrEmpty(Model.Flag)) { 
                        <img src="@Model.Flag" style="width: 20px; height: 14px; margin-left: 8px;" />
                    }
                </p>
            </div>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }
        else if (Model.Standings == null || !Model.Standings.Any())
        {
            <div class="text-center py-5">
                <div class="h4 text-muted">Няма налична информация за класацията в момента.</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table-standings">
                    <thead>
                        <tr>
                            <th class="text-center">#</th>
                            <th>Отбор</th>
                            <th class="text-center">М</th>
                            <th class="text-center">П</th>
                            <th class="text-center">Р</th>
                            <th class="text-center">З</th>
                            <th class="text-center hide-mobile">Г</th>
                            <th class="text-center pts-cell">Т</th>
                            <th class="hide-mobile">Форма</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.Standings)
                        {
                            <tr>
                                <td class="rank-cell">
                                    <span style="@(entry.rank <= 4 ? "color: #4ade80;" : entry.rank >= 18 ? "color: #f87171;" : "")">@entry.rank</span>
                                </td>
                                <td>
                                    <div class="team-cell">
                                        <img src="@entry.team?.logo" alt="@entry.team?.name" class="team-logo-small" />
                                        <div>
                                            <div class="team-name">@entry.team?.name</div>
                                            @if (!string.IsNullOrEmpty(entry.description))
                                            {
                                                <div class="badge-description hide-mobile">@entry.description</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center stats-cell">@entry.all?.played</td>
                                <td class="text-center stats-cell text-success">@entry.all?.win</td>
                                <td class="text-center stats-cell text-warning">@entry.all?.draw</td>
                                <td class="text-center stats-cell text-danger">@entry.all?.lose</td>
                                <td class="text-center stats-cell hide-mobile">@entry.all?.goals?.goalsFor : @entry.all?.goals?.against</td>
                                <td class="text-center rank-cell pts-cell">@entry.points</td>
                                <td class="hide-mobile">
                                    @if (!string.IsNullOrEmpty(entry.form))
                                    {
                                        var forms = entry.form.ToCharArray();
                                        foreach (var f in forms)
                                        {
                                            var cssClass = f == 'W' ? "form-w" : f == 'D' ? "form-d" : "form-l";
                                            <span class="form-indicator @cssClass">@f</span>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
