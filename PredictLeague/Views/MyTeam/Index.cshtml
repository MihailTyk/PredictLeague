@model PredictLeague.Controllers.MyTeamViewModel

@{
    ViewData["Title"] = "My Team";
    var formationPositions = ViewBag.Positions as List<string>;
}

<div class="container mt-4 mb-5">
    <!-- Header & Formation Selector -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-0">📋 My Squad</h1>
            <p class="text-muted small">Manage your starting XI and tactics</p>
        </div>
        
        <form asp-action="UpdateFormation" class="d-flex align-items-center gap-2 bg-white p-2 rounded shadow-sm border">
            <span class="fw-bold text-secondary small">FORMATION:</span>
            <select name="formation" class="form-select form-select-sm fw-bold border-0 bg-light" style="width: auto;" onchange="this.form.submit()">
                <!option value="4-4-2" @(Model.Settings.Formation == "4-4-2" ? "selected" : "")>4-4-2 Classical</!option>
                <!option value="4-3-3" @(Model.Settings.Formation == "4-3-3" ? "selected" : "")>4-3-3 Attack</!option>
                <!option value="3-5-2" @(Model.Settings.Formation == "3-5-2" ? "selected" : "")>3-5-2 Dynamic</!option>
                <!option value="5-3-2" @(Model.Settings.Formation == "5-3-2" ? "selected" : "")>5-3-2 Defensive</!option>
                <!option value="4-2-3-1" @(Model.Settings.Formation == "4-2-3-1" ? "selected" : "")>4-2-3-1 Modern</!option>
                <!option value="3-4-3" @(Model.Settings.Formation == "3-4-3" ? "selected" : "")>3-4-3 Total Attack</!option>
            </select>
        </form>
    </div>

    <div class="row g-4">
        <!-- PITCH Section (Left) -->
        <div class="col-lg-8">
            <div class="pitch-container shadow-lg rounded-4 position-relative overflow-hidden mb-3">
                <!-- Grass Pattern -->
                <div class="pitch-grass"></div>
                <!-- Lines -->
                <div class="pitch-lines">
                    <div class="center-circle"></div>
                    <div class="half-line"></div>
                    <div class="box-area-top"></div>
                    <div class="box-area-bottom"></div>
                </div>

                <!-- Players on Pitch -->
                <div class="players-overlay w-100 h-100 position-absolute top-0 start-0 p-3">
                    @foreach (var pos in formationPositions)
                    {
                        var player = Model.StartingLineup.FirstOrDefault(p => p.FieldPosition == pos);
                        var posClass = GetPositionGridClass(Model.Settings.Formation, pos);

                        <div class="player-slot @posClass" onclick="openPlayerSelector('@pos')">
                             @if (player != null)
                             {
                                 <div class="player-token verified @(player.Rating >= 85 ? "rare" : "")">
                                     <!-- Player Photo Background -->
                                     <img src="@(string.IsNullOrEmpty(player.PhotoUrl) ? "https://cdn-icons-png.flaticon.com/512/166/166344.png" : player.PhotoUrl)" 
                                          alt="@player.PlayerName" class="player-image-bg" />
                                     
                                     <div class="player-rating">@player.Rating.ToString("0")</div>
                                     <div class="player-pos-badge">@pos</div>
                                     
                                     <div class="card-overlay">
                                         <div class="player-name text-truncate">@player.PlayerName</div>
                                     </div>
                                     
                                     <!-- Remove Button -->
                                     <form asp-action="RemovePlayer" class="remove-btn-form">
                                         <input type="hidden" name="playerId" value="@player.Id" />
                                         <button type="submit" class="btn-remove" onclick="event.stopPropagation()">×</button>
                                     </form>
                                 </div>
                             }
                             else
                             {
                                 <div class="player-token empty">
                                     <div class="plus-icon">+</div>
                                     <div class="player-pos-badge">@pos</div>
                                 </div>
                             }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- BENCH Section (Right) -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light fw-bold py-3 d-flex justify-content-between align-items-center">
                    <span>💺 Bench (@Model.Bench.Count)</span>
                    <a asp-controller="Players" asp-action="Index" class="btn btn-sm btn-primary rounded-pill px-3">+ Scout</a>
                </div>
                <div class="card-body p-0 overflow-auto" style="max-height: 600px;">
                    @if (!Model.Bench.Any())
                    {
                        <div class="text-center p-5 text-muted">
                            <p class="mb-2">👻</p>
                            <p>No players on bench.</p>
                            <a asp-controller="Players" asp-action="Index" class="small">Find players</a>
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var p in Model.Bench)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-bold text-dark">@p.PlayerName</div>
                                        <div class="small text-muted">@p.Position • @p.TeamName</div>
                                    </div>
                                    <div class="badge bg-secondary">@p.Rating.ToString("0.0")</div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Player Selection -->
<div class="modal fade" id="playerSelectorModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Select Player for <span id="targetPosName" class="text-primary"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="list-group list-group-flush" id="modalPlayerList">
                    @foreach (var p in Model.Bench)
                    {
                        <form asp-action="AssignPlayer" method="post" class="w-100">
                            <input type="hidden" name="playerId" value="@p.Id" />
                            <input type="hidden" name="position" id="inputPos-@p.Id" />
                            
                            <button type="submit" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3 border rounded mb-2">
                                <div class="d-flex align-items-center">
                                    <div class="badge bg-light text-dark border me-3" style="width:35px">@p.Rating.ToString("0")</div>
                                    <div>
                                        <div class="fw-bold">@p.PlayerName</div>
                                        <div class="small text-muted">@p.TeamName • <span class="text-info">@p.Position</span></div>
                                    </div>
                                </div>
                                <span class="btn btn-sm btn-outline-primary rounded-pill">Select</span>
                            </button>
                        </form>
                    }
                    @if (!Model.Bench.Any())
                    {
                         <div class="text-center py-4 text-muted">
                             No players available on bench.
                         </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function openPlayerSelector(positionCode) {
        document.getElementById('targetPosName').innerText = positionCode;
        
        // Update all hidden inputs in the modal with the selected position
        var inputs = document.querySelectorAll('input[name="position"]');
        inputs.forEach(input => input.value = positionCode);
        
        var myModal = new bootstrap.Modal(document.getElementById('playerSelectorModal'));
        myModal.show();
    }
</script>

@functions {
    public string GetPositionGridClass(string formation, string pos)
    {
        // Simple positioning logic based on percentage coordinate system (top/left)
        // Adjust these coords for visual balance on the vertical pitch
        
        if (pos == "GK") return "pos-gk";
        
        if (formation == "4-4-2")
        {
            if (pos == "LB") return "pos-lb";
            if (pos == "RB") return "pos-rb";
            if (pos == "CB1") return "pos-cb1";
            if (pos == "CB2") return "pos-cb2";
            if (pos == "LM") return "pos-lm";
            if (pos == "RM") return "pos-rm";
            if (pos == "CM1") return "pos-cm1";
            if (pos == "CM2") return "pos-cm2";
            if (pos == "ST1") return "pos-st1";
            if (pos == "ST2") return "pos-st2";
        }
        else if (formation == "4-3-3")
        {
             if (pos == "LB") return "pos-lb";
            if (pos == "RB") return "pos-rb";
            if (pos == "CB1") return "pos-cb1";
            if (pos == "CB2") return "pos-cb2";
            // Mids
            if (pos == "CM1") return "pos-lcm";
            if (pos == "CM2") return "pos-ccm";
            if (pos == "CM3") return "pos-rcm";
             // Attack
            if (pos == "LW") return "pos-lw";
            if (pos == "ST") return "pos-st-c"; // Center Striker
            if (pos == "RW") return "pos-rw";
        }
        else if (formation == "3-5-2")
        {
            if (pos == "CB1") return "pos-lcb";
            if (pos == "CB2") return "pos-ccb";
            if (pos == "CB3") return "pos-rcb";
            if (pos == "LM") return "pos-lm";
            if (pos == "RM") return "pos-rm";
            if (pos == "CM1") return "pos-lcm";
            if (pos == "CM2") return "pos-ccm";
            if (pos == "CM3") return "pos-rcm";
            if (pos == "ST1") return "pos-st1";
            if (pos == "ST2") return "pos-st2";
        }
        else if (formation == "5-3-2")
        {
            if (pos == "LB") return "pos-lb";
            if (pos == "RB") return "pos-rb";
            if (pos == "CB1") return "pos-lcb";
            if (pos == "CB2") return "pos-ccb";
            if (pos == "CB3") return "pos-rcb";
            if (pos == "CM1") return "pos-lcm";
            if (pos == "CM2") return "pos-ccm";
            if (pos == "CM3") return "pos-rcm";
            if (pos == "ST1") return "pos-st1";
            if (pos == "ST2") return "pos-st2";
        }
        else if (formation == "4-2-3-1")
        {
            if (pos == "LB") return "pos-lb";
            if (pos == "RB") return "pos-rb";
            if (pos == "CB1") return "pos-cb1";
            if (pos == "CB2") return "pos-cb2";
            if (pos == "DM1") return "pos-ldm";
            if (pos == "DM2") return "pos-rdm";
            if (pos == "LM") return "pos-lm";
            if (pos == "CAM") return "pos-cam";
            if (pos == "RM") return "pos-rm";
            if (pos == "ST") return "pos-st-c";
        }
        else if (formation == "3-4-3")
        {
            if (pos == "CB1") return "pos-lcb";
            if (pos == "CB2") return "pos-ccb";
            if (pos == "CB3") return "pos-rcb";
            if (pos == "LM") return "pos-lm";
            if (pos == "RM") return "pos-rm";
            if (pos == "CM1") return "pos-cm1";
            if (pos == "CM2") return "pos-cm2";
            if (pos == "LW") return "pos-lw";
            if (pos == "RW") return "pos-rw";
            if (pos == "ST") return "pos-st-c";
        }
        
        return "pos-gk"; // fallback
    }
}

<style>
    /* Pitch Visuals */
    .pitch-container {
        width: 100%;
        padding-top: 135%; /* Aspect Ratio of a pitch roughly */
        background-color: #2d5a27;
        position: relative;
        border: 4px solid rgba(255,255,255,0.8);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        border-radius: 20px !important;
    }
    
    .pitch-grass {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: 
            linear-gradient(rgba(0,0,0,0.1) 1px, transparent 1px),
            repeating-linear-gradient(
                0deg,
                #2d5a27,
                #2d5a27 10%,
                #34682e 10%,
                #34682e 20%
            );
        opacity: 1;
    }
    
    /* Center circle and other lines with glowing effect */
    .pitch-lines div {
        border-color: rgba(255,255,255,0.4) !important;
        box-shadow: 0 0 10px rgba(255,255,255,0.1);
    }

    .pitch-lines .half-line {
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        height: 2px;
        background: rgba(255,255,255,0.4);
    }
    
    .pitch-lines .center-circle {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 25%;
        padding-top: 25%;
        border: 2px solid rgba(255,255,255,0.4);
        border-radius: 50%;
        transform: translate(-50%, -50%);
    }

    /* Player Slots with Transitions */
    .player-slot {
        position: absolute;
        transform: translate(-50%, -50%);
        width: 16%; 
        height: 14%; 
        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); /* Smooth movement for formation change */
        z-index: 2;
    }
    
    .player-slot:hover {
        z-index: 10;
        transform: translate(-50%, -50%) scale(1.15) !important;
    }

    /* FIFA STYLE CARD */
    .player-token {
        width: 100%;
        height: 100%;
        border-radius: 6px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
        position: relative;
        overflow: hidden;
        background-size: cover;
        background-position: center;
        transition: box-shadow 0.3s;
    }

    .player-token.verified {
        background: linear-gradient(135deg, #1a1a1a 0%, #333333 100%);
        border: 2px solid #ffd700;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.4);
    }

    /* Gold Gradient for Rare Players (Rating > 85) */
    .player-token.rare {
        background: linear-gradient(135deg, #bf953f, #fcf6ba, #b38728, #fbf5b7, #aa771c);
        border: 2px solid #5d4a1e;
        color: #1a1a1a !important;
    }

    .player-image-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 1;
        opacity: 0.85;
        transition: opacity 0.3s;
    }

    .player-token:hover .player-image-bg {
        opacity: 1;
    }

    .card-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0) 100%);
        padding: 5px;
        z-index: 2;
        text-align: center;
    }

    .player-token.rare .card-overlay {
        background: linear-gradient(to top, rgba(255,255,255,0.3) 0%, rgba(255,255,255,0) 100%);
    }

    .player-rating {
        position: absolute;
        top: 5px;
        left: 5px;
        font-weight: 900;
        font-size: 1rem;
        z-index: 3;
        background: rgba(0,0,0,0.6);
        color: #ffd700;
        padding: 2px 4px;
        border-radius: 4px;
        line-height: 1;
    }

    .player-token.rare .player-rating {
        background: #1a1a1a;
        color: #fff;
    }
    
    .player-name {
        font-size: 0.65rem;
        font-weight: 800;
        color: #fff;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.8);
    }

    .player-token.rare .player-name {
        color: #222;
        text-shadow: none;
    }
    
    .player-pos-badge {
        position: absolute;
        top: 5px;
        right: 5px;
        background: #ffd700;
        color: #000;
        font-size: 0.55rem;
        padding: 1px 4px;
        border-radius: 3px;
        font-weight: 900;
        z-index: 3;
    }
    
    .player-token.empty {
        background: rgba(255,255,255,0.1);
        backdrop-filter: blur(4px);
        border: 2px dashed rgba(255,255,255,0.3);
        color: rgba(255,255,255,0.5);
    }
    
    .player-token.empty:hover {
        background: rgba(255,255,255,0.2);
        border-color: #fff;
        color: #fff;
    }

    /* POSITIONS CSS (Top% Left%) */
    .pos-gk { top: 88%; left: 50%; }
    
    .pos-lb { top: 72%; left: 15%; }
    .pos-cb1 { top: 76%; left: 35%; }
    .pos-cb2 { top: 76%; left: 65%; }
    .pos-rb { top: 72%; left: 85%; }
    
    .pos-lm { top: 45%; left: 15%; }
    .pos-cm1 { top: 50%; left: 35%; }
    .pos-cm2 { top: 50%; left: 65%; }
    .pos-rm { top: 45%; left: 85%; }
    
    /* 3-man defense / 5-man defense specials */
    .pos-lcb { top: 76%; left: 25%; }
    .pos-ccb { top: 80%; left: 50%; }
    .pos-rcb { top: 76%; left: 75%; }
    
    .pos-lcm { top: 52%; left: 28%; }
    .pos-ccm { top: 58%; left: 50%; }
    .pos-rcm { top: 52%; left: 72%; }

    .pos-ldm { top: 62%; left: 35%; }
    .pos-rdm { top: 62%; left: 65%; }
    .pos-cam { top: 38%; left: 50%; }

    .pos-st1 { top: 20%; left: 35%; }
    .pos-st2 { top: 20%; left: 65%; }
    
    .pos-lw { top: 18%; left: 18%; }
    .pos-st-c { top: 12%; left: 50%; }
    .pos-rw { top: 18%; left: 82%; }

</style>
