@model List<PredictLeague.Controllers.TeamLeaderboardEntry>

@{
    ViewData["Title"] = "Team Leaderboard";
}

<div class="container mt-5 mb-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">🏆 Класация на отборите</h1>
        <p class="lead text-muted">Кой притежава най-силния състав?</p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <div class="display-1 mb-3">👻</div>
            <h3>Все още няма отбори!</h3>
            <p>Отиди на <a asp-controller="Players" asp-action="Index">Пазара</a>, за да изградиш своя отбор.</p>
        </div>
    }
    else
    {
        <div class="card shadow border-0 overflow-hidden rounded-4">
            <div class="card-header bg-gradient-primary text-white p-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="row align-items-center fw-bold text-uppercase small letter-spacing-1 text-center">
                    <div class="col-1">Място</div>
                    <div class="col-4 text-start">Отбор / Мениджър</div>
                    <div class="col-2">Играчи</div>
                    <div class="col-2">Стойност</div>
                    <div class="col-3">Звезда</div>
                </div>
            </div>
            <div class="list-group list-group-flush">
                @{ var rank = 1; }
                @foreach (var entry in Model)
                {
                    var bgClass = rank == 1 ? "bg-warning-subtle" : (rank == 2 ? "bg-secondary-subtle" : (rank == 3 ? "bg-danger-subtle" : ""));
                    var borderClass = rank <= 3 ? "border-start border-5" : "";
                    var borderColor = rank == 1 ? "border-warning" : (rank == 2 ? "border-secondary" : (rank == 3 ? "border-danger" : ""));
                    
                    <div class="list-group-item p-4 transition-hover @bgClass @borderClass @borderColor">
                        <div class="row align-items-center">
                            <div class="col-1 text-center">
                                @if (rank == 1) { <span class="fs-2">🥇</span> }
                                else if (rank == 2) { <span class="fs-2">🥈</span> }
                                else if (rank == 3) { <span class="fs-2">🥉</span> }
                                else { <span class="badge bg-light text-dark rounded-circle p-2 fs-6 shadow-sm" style="width:32px;height:32px;">@rank</span> }
                            </div>
                            <div class="col-4">
                                <div class="d-flex align-items-center">
                                    <div class="avatar bg-gradient rounded-circle text-white d-flex align-items-center justify-content-center me-3 shadow-sm"
                                         style="width: 50px; height: 50px; background-color: #@entry.UserName.GetHashCode().ToString("X").Substring(0,6);">
                                        @if(!string.IsNullOrEmpty(entry.TeamBadgeUrl) && entry.TeamBadgeUrl.Contains("http")) {
                                            <img src="@entry.TeamBadgeUrl" style="width: 35px; height: 35px; object-fit: contain;">
                                        } else {
                                            @entry.UserName.Substring(0, 1).ToUpper()
                                        }
                                    </div>
                                    <div>
                                        <h4 class="mb-0 fw-bold text-dark">@entry.TeamName</h4>
                                        <small class="text-muted">Мениджър: @entry.UserName</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-2 text-center">
                                <div class="text-muted small text-uppercase fw-bold mb-1">Състав</div>
                                <span class="badge bg-white text-primary border border-primary px-3 py-2 rounded-pill">
                                    👥 @entry.PlayerCount Играчи
                                </span>
                            </div>
                            <div class="col-2 text-center">
                                <div class="text-muted small text-uppercase fw-bold mb-1">Стойност</div>
                                <div class="fw-bold text-success">💰 @entry.TotalCost <small>PTS</small></div>
                            </div>
                            <div class="col-3 text-truncate">
                                <div class="text-muted small text-uppercase fw-bold mb-1">Звезда</div>
                                @if(!string.IsNullOrEmpty(entry.BestPlayer))
                                {
                                    <span class="fw-semibold">🌟 @entry.BestPlayer</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </div>
                        </div>
                    </div>
                    rank++;
                }
            </div>
        </div>
    }
</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease, background-color 0.2s ease;
    }
    .transition-hover:hover {
        transform: scale(1.01);
        z-index: 10;
        box-shadow: 0 10px 20px rgba(0,0,0,0.05);
        background-color: white !important;
    }
    .letter-spacing-1 {
        letter-spacing: 1px;
    }
</style>
