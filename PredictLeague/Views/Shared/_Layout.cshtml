@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject PredictLeague.Data.PredictLeagueContext DbContext
<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PredictLeague</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>

    <style>
        body {
            background-color: #f0f2f5;
            font-family: 'Inter', sans-serif;
            padding-top: 80px; /* За да не се крие контентът зад фиксираната навигация */
        }

        /* 🌑 PREMIUM DARK NAVBAR */
        .custom-navbar {
            background: rgba(15, 23, 42, 0.95); /* Модерен тъмен цвят (Slate 900) */
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.15);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s ease;
            padding: 0.8rem 0;
        }

        .brand-text {
            color: #ffd700;
            background: linear-gradient(90deg, #ffd700, #ffaa00);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-family: 'Poppins', sans-serif;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .nav-link {
            color: rgba(255, 255, 255, 0.75) !important;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .nav-link:hover, .nav-link.active {
            color: #ffd700 !important;
            background-color: rgba(255, 255, 255, 0.05);
            transform: translateY(-2px);
        }

        .custom-dropdown {
            background-color: rgba(15, 23, 42, 0.98);
            border-radius: 12px;
            padding: 0.5rem;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .custom-dropdown .dropdown-item {
            color: #e2e8f0;
            border-radius: 8px;
            padding: 0.5rem 1rem;
            transition: background 0.2s;
        }

        .custom-dropdown .dropdown-item:hover {
            background-color: rgba(255, 255, 255, 0.08);
            color: #ffd700;
        }

        /* 🟢 USER POINTS BADGE */
        .points-badge {
            background: linear-gradient(135deg, #ffd700, #ffaa00);
            color: #0f172a;
            font-family: 'Poppins', sans-serif;
        }

        /* LOGIN / REGISTER BUTTONS */
        .btn-login {
            background: transparent;
            border: 2px solid rgba(255, 255, 255, 0.2);
            color: #fff !important;
            border-radius: 50px;
            padding: 0.4rem 1.2rem;
            font-weight: 600;
        }

        .btn-login:hover {
            border-color: #ffd700;
            color: #ffd700 !important;
        }

        .btn-register {
            background: #ffd700;
            color: #0f172a !important;
            border: none;
            border-radius: 50px;
            padding: 0.4rem 1.2rem;
            font-weight: 700;
            box-shadow: 0 4px 15px rgba(255, 215, 0, 0.2);
            transition: transform 0.2s;
        }

        .btn-register:hover {
            background: #ffea00;
            transform: translateY(-2px);
        }

        /* ⚽ FOOTER */
        footer {
            background-color: #0f172a;
            color: #94a3b8;
            padding: 30px 0;
            margin-top: 60px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        footer a {
            color: #cbd5e1;
            text-decoration: none;
            transition: color 0.2s;
        }

        footer a:hover {
            color: #ffd700;
        }

        main {
            min-height: 70vh;
        }

        /* 🔙 BACK BUTTON */
        .back-btn-container {
            margin-bottom: 2rem;
            margin-top: 1rem;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 10px 22px;
            background: rgba(15, 23, 42, 0.05);
            border: 1px solid rgba(15, 23, 42, 0.1);
            border-radius: 50px;
            color: #0f172a;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            backdrop-filter: blur(5px);
        }

        .back-btn:hover {
            background: #0f172a;
            color: #ffd700 !important;
            transform: translateX(-5px);
            box-shadow: 0 10px 20px rgba(15, 23, 42, 0.15);
            border-color: #0f172a;
        }

        .back-btn i {
            transition: transform 0.3s ease;
        }

        .back-btn:hover i {
            transform: translateX(-3px);
        }
    </style>
</head>

<body>

    <!-- ✅ MODERN NAVIGATION -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark fixed-top custom-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" asp-controller="Home" asp-action="Index">
                    <span class="fs-4">⚽</span> <span class="brand-text">PredictLeague</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1 align-items-center ms-lg-4">
                        
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill" asp-controller="Home" asp-action="Index">🏠 Начало</a>
                        </li>

                        <!-- МЕНЮ: ПРОГНОЗИ -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle px-3 rounded-pill" href="#" id="leaguesDropdown"
                               role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                🌍 Прогнозирай
                            </a>
                            <ul class="dropdown-menu custom-dropdown shadow-lg" aria-labelledby="leaguesDropdown">
                                <li><a class="dropdown-item" asp-controller="Matches" asp-action="PremierLeague">🏴 Premier League</a></li>
                                <li><a class="dropdown-item" asp-controller="Matches" asp-action="LaLiga">🇪🇸 La Liga</a></li>
                                <li><a class="dropdown-item" asp-controller="Matches" asp-action="SerieA">🇮🇹 Serie A</a></li>
                                <li><a class="dropdown-item" asp-controller="Matches" asp-action="Bundesliga">🇩🇪 Bundesliga</a></li>
                                <li><a class="dropdown-item" asp-controller="Matches" asp-action="Ligue1">🇫🇷 Ligue 1</a></li>
                                <li><a class="dropdown-item" asp-controller="Matches" asp-action="PrimeiraLiga">🇵🇹 Primeira Liga</a></li>
                                <li><a class="dropdown-item" asp-controller="Matches" asp-action="Eredivisie">🇳🇱 Eredivisie</a></li>
                                <li><a class="dropdown-item" asp-controller="Matches" asp-action="ParvaLiga">🇧🇬 Parva Liga</a></li>
                                <li><hr class="dropdown-divider border-secondary opacity-25"></li>
                                <li><a class="dropdown-item" asp-controller="Matches" asp-action="ChampionsLeague">🏆 Champions League</a></li>
                            </ul>
                        </li>

                        <!-- МЕНЮ: FANTASY -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle px-3 rounded-pill" href="#" id="fantasyDropdown"
                               role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                🎮 Fantasy Отбор
                            </a>
                            <ul class="dropdown-menu custom-dropdown shadow-lg" aria-labelledby="fantasyDropdown">
                                @if (SignInManager.IsSignedIn(User))
                                {
                                    <li><a class="dropdown-item" asp-controller="MyTeam" asp-action="Index">👕 Моят Отбор</a></li>
                                }
                                <li><a class="dropdown-item" asp-controller="Players" asp-action="Index">🛒 Пазар (Всички Играчи)</a></li>
                                <li><hr class="dropdown-divider border-secondary opacity-25"></li>
                                <li><a class="dropdown-item text-warning fw-bold" asp-controller="Leaderboard" asp-action="Index">🏆 Класация</a></li>
                            </ul>
                        </li>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 rounded-pill text-info fw-semibold" asp-controller="MyPredictions" asp-action="Index">📋 Моите Прогнози</a>
                            </li>
                        }

                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                        {
                            <li class="nav-item ms-lg-2">
                                <a class="nav-link px-3 rounded-pill text-warning fw-bold border border-warning" style="background: rgba(255, 215, 0, 0.1);" asp-controller="Admin" asp-action="Index">🛠️ Админ Панел</a>
                            </li>
                        }
                    </ul>

                    <!-- LOGIN / USER BUBBLE -->
                    <ul class="navbar-nav align-items-center gap-3">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var userId = UserManager.GetUserId(User);
                            var teamSettings = DbContext.UserTeamSettings.FirstOrDefault(s => s.UserId == userId);
                            var points = teamSettings != null ? teamSettings.Points : 0;
                            var rawUserName = UserManager.GetUserName(User) ?? "User";
                            var displayUserName = rawUserName.Contains("@") ? rawUserName.Split('@')[0] : rawUserName;

                            <li class="nav-item">
                                <div class="points-badge px-3 py-1 rounded-pill fw-bold shadow-sm d-flex align-items-center gap-2" title="Наличен бюджет за трансфери">
                                    <span class="fs-5">💰</span> <span>Бюджет: @points</span>
                                </div>
                            </li>
                            <li class="nav-item dropdown user-dropdown">
                                <a class="nav-link dropdown-toggle text-white fw-semibold d-flex align-items-center gap-2 px-3 rounded-pill" style="background: rgba(255,255,255,0.1);" href="#" role="button" data-bs-toggle="dropdown">
                                    <div class="user-avatar bg-white border border-light rounded-circle shadow-sm overflow-hidden d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        @if (teamSettings != null && !string.IsNullOrEmpty(teamSettings.TeamBadgeUrl))
                                        {
                                            <img src="@teamSettings.TeamBadgeUrl" alt="Badge" style="width: 100%; height: 100%; object-fit: contain; padding: 2px;">
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-primary">@(displayUserName.Length > 0 ? displayUserName.Substring(0, 1).ToUpper() : "U")</span>
                                        }
                                    </div>
                                    @displayUserName
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end custom-dropdown shadow-lg mt-2">
                                    <li>
                                        <form class="form-inline w-100" asp-area="Identity" asp-page="/Account/Logout" method="post">
                                            <button type="submit" class="dropdown-item text-danger fw-bold text-center">Изход от профила</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link btn-login" asp-area="Identity" asp-page="/Account/Login">Вход</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn-register" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- ✅ MAIN CONTENT -->
    <div class="container pb-5">
        @if (ViewContext.RouteData.Values["controller"]?.ToString() != "Home" || ViewContext.RouteData.Values["action"]?.ToString() != "Index")
        {
            <div class="back-btn-container animate__animated animate__fadeIn">
                <a href="javascript:history.back()" class="back-btn">
                    <i>⬅️</i> Назад
                </a>
            </div>
        }
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- ✅ FOOTER -->
    <footer>
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
            <div class="mb-3 mb-md-0">
                <span class="text-white fw-bold">⚽ PredictLeague</span> &copy; @DateTime.Now.Year | Всички права запазени.
            </div>
            <div class="d-flex gap-4">
                <a asp-controller="Home" asp-action="Index">Начало</a>
                <a asp-controller="Home" asp-action="Privacy">Политика за Поверителност</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
