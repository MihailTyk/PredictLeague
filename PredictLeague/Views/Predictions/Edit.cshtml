@model PredictLeague.Models.Prediction

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Prediction</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Hidden ID -->
            <input type="hidden" asp-for="Id" />

            <!-- Hidden UserId to preserve original user -->
            <input type="hidden" asp-for="UserId" />

            <!-- Match -->
            <div class="form-group">
                <label class="control-label">Match</label>
                <select asp-for="MatchId" class="form-control" asp-items="ViewBag.MatchId"></select>
                <span asp-validation-for="MatchId" class="text-danger"></span>
            </div>

            <!-- Predicted Home Score -->
            <div class="form-group">
                <label asp-for="PredictedHomeScore" class="control-label"></label>
                <input asp-for="PredictedHomeScore" class="form-control" type="number" min="0" />
                <span asp-validation-for="PredictedHomeScore" class="text-danger"></span>
            </div>

            <!-- Predicted Away Score -->
            <div class="form-group">
                <label asp-for="PredictedAwayScore" class="control-label"></label>
                <input asp-for="PredictedAwayScore" class="form-control" type="number" min="0" />
                <span asp-validation-for="PredictedAwayScore" class="text-danger"></span>
            </div>

            <!-- CreatedAt -->
            <div class="form-group">
                <label asp-for="CreatedAt" class="control-label"></label>
                <input asp-for="CreatedAt" class="form-control" type="datetime-local" />
                <span asp-validation-for="CreatedAt" class="text-danger"></span>
            </div>

            <!-- Save button -->
            <div class="form-group mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>

        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
