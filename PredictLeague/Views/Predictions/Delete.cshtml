@model PredictLeague.Models.Prediction

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete Prediction</h1>

<h3>Are you sure you want to delete this prediction?</h3>

<div>
    <h4>Prediction Details</h4>
    <hr />

    <dl class="row">

        <!-- Match -->
        <dt class="col-sm-2">Match</dt>
        <dd class="col-sm-10">
            @Model.Match?.HomeTeam vs @Model.Match?.AwayTeam
        </dd>

        <!-- Home Prediction -->
        <dt class="col-sm-2">Predicted Home Score</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PredictedHomeScore)
        </dd>

        <!-- Away Prediction -->
        <dt class="col-sm-2">Predicted Away Score</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PredictedAwayScore)
        </dd>

        <!-- Created At -->
        <dt class="col-sm-2">Created At</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CreatedAt)
        </dd>

        <!-- Points (optional) -->
        <dt class="col-sm-2">Points Earned</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Points)
        </dd>

    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
